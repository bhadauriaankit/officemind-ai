{
  "title": "OfficeMind AI Overview",
  "uid": "officemind-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests / sec",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{job=\"officemind-backend\"}[1m])",
        "legendFormat": "{{uri}} {{status}}"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 2,
      "title": "HTTP Request Duration p99 (s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"officemind-backend\"}[5m]))",
        "legendFormat": "p99 {{uri}}"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 3,
      "title": "JVM Heap Used (MB)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"officemind-backend\"} / 1024 / 1024",
        "legendFormat": "{{id}}"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 4,
      "title": "Active DB Connections",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "hikaricp_connections_active{job=\"officemind-backend\"}",
        "legendFormat": "Active"
      }],
      "datasource": "Prometheus"
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
